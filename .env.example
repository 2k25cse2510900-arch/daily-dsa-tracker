PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/DATABASE?retryWrites=true&w=majority
SESSION_SECRET=replace-with-at-least-32-random-bytes
# Used only by npm.cmd run provision-admin; not read by the running server.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-strong-password-of-at-least-14-characters
# Comma, semicolon, or whitespace separated verified Google emails allowed to join this private group.
# Link each email to its existing dashboard member from Members → Set sign-in email after admin login.
MEMBER_ALLOWLIST_EMAILS=member-one@example.com,member-two@example.com
# Optional: set to false to disable first-time personal profile registration. Omit or use true to allow verified Google onboarding.
# MEMBER_SELF_REGISTRATION=true
CRON_SECRET=replace-with-a-random-secret-for-scheduled-refreshes
# Public Firebase web configuration, from Firebase Project settings > General > Your apps.
FIREBASE_API_KEY=replace-with-your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_APP_ID=1:123456789:web:replace-with-your-app-id
# Firebase Admin authentication: choose one option, never both.
# Local ADC: point this at an untracked service-account JSON file. Google Cloud CLI is not required.
# GOOGLE_APPLICATION_CREDENTIALS=C:\absolute\path\to\firebase-service-account.json
# Deployment: set both values in the host's secret manager instead of this file.
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-example@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-private-key\n-----END PRIVATE KEY-----\n"
