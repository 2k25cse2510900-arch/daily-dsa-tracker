{
  "manifest_version": 3,
  "name": "DSAverse LeetCode Sync",
  "version": "1.1.0",
  "description": "Automatically and securely sync your submitted code and verdict directly into DSAverse AI Code Mentor.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://leetcode.com/*",
    "*://leetcode.cn/*",
    "http://127.0.0.1:*/*",
    "http://localhost:*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DSAverse Auto-Sync"
  },
  "content_scripts": [
    {
      "matches": [
        "*://leetcode.com/problems/*",
        "*://leetcode.cn/problems/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://leetcode.com/problems/*",
        "*://leetcode.cn/problems/*"
      ],
      "js": ["page-hook.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-hook.js"],
      "matches": [
        "*://leetcode.com/*",
        "*://leetcode.cn/*"
      ]
    }
  ]
}
